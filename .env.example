# CHANGE ALL SECRETS BEFORE SHARING OR DEPLOYING THE APPLICATION
FLASK_SECRET_KEY=replace-with-a-long-random-secret
REVIEWER_ACCESS_CODE=replace-reviewer-access-code
TAX_EXPERT_ACCESS_CODE=replace-tax-expert-access-code
ADMIN_ACCESS_CODE=replace-admin-access-code

# Required for generating answers to freely entered questions. Without a live API, exact
# benchmark questions show archived answers and new questions show evidence-only previews.
RAG_API_URL=
RAG_API_TIMEOUT=180

# Set to 1 only when serving behind HTTPS.
SESSION_COOKIE_SECURE=0
HOST=127.0.0.1
PORT=5000
FLASK_DEBUG=0
